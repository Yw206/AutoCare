@model IEnumerable<Vehicle>
@{ ViewData["Title"] = "My Vehicles"; }
<div class="page-heading"><div><div class="eyebrow">Vehicle garage</div><h1>My Vehicles</h1><p>Keep your vehicle information ready for workshop appointments.</p></div><a class="btn btn-primary" asp-action="Create">＋ Add Vehicle</a></div>
@if(!Model.Any()){<div class="panel empty-state"><div class="empty-icon">▰</div><h2 class="h5">No vehicle registered</h2><p>Add your first vehicle before booking a workshop service.</p><a class="btn btn-primary" asp-action="Create">Add Vehicle</a></div>}
else{<div class="row g-3">@foreach(var vehicle in Model){<div class="col-lg-4 col-md-6"><article class="vehicle-card"><div class="vehicle-art">🚘</div><div class="d-flex justify-content-between align-items-start"><div><div class="vehicle-registration">@vehicle.RegistrationNumber</div><div class="vehicle-meta">@vehicle.Year @vehicle.Brand @vehicle.Model<br />@(vehicle.Colour ?? "Colour not specified") · @vehicle.Mileage.ToString("N0") km</div></div><span class="status-badge Active">Active</span></div><div class="quick-actions mt-3"><a class="btn btn-outline-primary btn-sm" asp-action="Edit" asp-route-id="@vehicle.Id">Edit Details</a><a class="btn btn-primary btn-sm" asp-controller="Appointments" asp-action="Create">Book Service</a><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@vehicle.Id" /><button class="btn btn-outline-danger btn-sm" onclick="return confirm('Delete this vehicle?')">Delete</button></form></div></article></div>}</div>}
