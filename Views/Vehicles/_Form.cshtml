@model Vehicle
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input asp-for="Id" type="hidden" /><div class="form-section"><h3>Vehicle identification</h3><div class="row"><div class="col-md-4 mb-3"><label asp-for="RegistrationNumber"></label><input asp-for="RegistrationNumber" class="form-control" placeholder="ABC 1234" /><span asp-validation-for="RegistrationNumber" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="Brand"></label><input asp-for="Brand" class="form-control" placeholder="e.g. Toyota" /><span asp-validation-for="Brand" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="Model"></label><input asp-for="Model" class="form-control" placeholder="e.g. Camry" /><span asp-validation-for="Model" class="text-danger"></span></div></div></div><div class="form-section"><h3>Vehicle details</h3><div class="row"><div class="col-md-4 mb-3"><label asp-for="Year"></label><input asp-for="Year" class="form-control" /><span asp-validation-for="Year" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="Mileage"></label><div class="input-group"><input asp-for="Mileage" class="form-control" /><span class="input-group-text">km</span></div><span asp-validation-for="Mileage" class="text-danger"></span></div><div class="col-md-4 mb-3"><label asp-for="Colour"></label><input asp-for="Colour" class="form-control" placeholder="Vehicle colour" /><span asp-validation-for="Colour" class="text-danger"></span></div></div></div><div class="quick-actions mt-3"><button class="btn btn-primary">Save Vehicle</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div>
