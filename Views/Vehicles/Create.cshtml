@model Vehicle
@{ ViewData["Title"] = UiText.T(Context, "Add Vehicle", "添加车辆", "Tambah Kenderaan"); }
<div class="page-heading">
    <div>
        <div class="eyebrow">@UiText.T(Context, "Vehicle garage", "车辆车库", "Garaj kenderaan")</div>
        <h1>@UiText.T(Context, "Add a Vehicle", "添加车辆", "Tambah Kenderaan")</h1>
        <p>@UiText.T(Context, "Enter accurate details so the workshop can identify your vehicle.", "填写准确资料，方便车厂识别您的车辆。", "Masukkan butiran tepat supaya bengkel dapat mengenal pasti kenderaan anda.")</p>
    </div>
</div>
<form method="post" class="panel form-panel"><partial name="_Form" model="Model" /></form>
