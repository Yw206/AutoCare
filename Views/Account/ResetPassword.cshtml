@model ResetPasswordVm
@{ ViewData["Title"] = UiText.T(Context, "Reset Password", "重设密码", "Tetapkan Semula Kata Laluan"); }
<div class="auth-wrap"><section class="auth-visual"><div class="eyebrow">@UiText.T(Context, "Verification required", "需要验证", "Pengesahan diperlukan")</div><h1>@UiText.T(Context, "Create a new password.", "创建新密码。", "Cipta kata laluan baru.")</h1><p>@UiText.T(Context, "Use the six-digit reset code generated for your AutoCare account.", "使用为您的 AutoCare 账户生成的六位重设码。", "Gunakan kod enam digit untuk akaun AutoCare anda.")</p></section><section class="auth-form-side"><div class="auth-card"><div class="eyebrow">@UiText.T(Context, "Secure reset", "安全重设", "Tetapan selamat")</div><h1 class="h2">@UiText.T(Context, "Reset password", "重设密码", "Tetapkan kata laluan")</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input asp-for="Email" type="hidden" /><div class="mb-3"><label asp-for="Otp" class="form-label">@UiText.T(Context, "Reset code", "重设码", "Kod tetapan")</label><input asp-for="Otp" class="form-control" maxlength="6" placeholder="000000" /><span asp-validation-for="Otp" class="text-danger"></span></div><div class="mb-3"><label asp-for="NewPassword" class="form-label">@UiText.T(Context, "New password", "新密码", "Kata laluan baru")</label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div><div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">@UiText.T(Context, "Confirm password", "确认密码", "Sahkan kata laluan")</label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><button class="btn btn-primary w-100">@UiText.T(Context, "Reset Password", "重设密码", "Tetapkan Semula")</button></form></div></section></div>
