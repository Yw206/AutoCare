@model ResetPasswordVm
@{ ViewData["Title"] = "Reset Password"; }
<div class="auth-wrap"><section class="auth-visual"><div class="eyebrow">Verification required</div><h1>Create a new password.</h1><p>Use the six-digit reset code generated for your AutoCare account.</p></section><section class="auth-form-side"><div class="auth-card"><div class="eyebrow">Secure reset</div><h1 class="h2">Reset password</h1>@if(TempData["DevelopmentOtp"] != null){<div class="auth-note mb-3"><strong>Development reset code:</strong> @TempData["DevelopmentOtp"]</div>}<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><input asp-for="Email" type="hidden" /><div class="mb-3"><label asp-for="Otp" class="form-label">Reset code</label><input asp-for="Otp" class="form-control" maxlength="6" placeholder="000000" /><span asp-validation-for="Otp" class="text-danger"></span></div><div class="mb-3"><label asp-for="NewPassword" class="form-label"></label><input asp-for="NewPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="NewPassword" class="text-danger"></span></div><div class="mb-3"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><button class="btn btn-primary w-100">Reset Password</button></form></div></section></div>
