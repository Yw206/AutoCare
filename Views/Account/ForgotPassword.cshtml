@model ForgotPasswordVm
@{ ViewData["Title"] = "Forgot Password"; }
<div class="auth-wrap"><section class="auth-visual"><div class="eyebrow">Account recovery</div><h1>Reset access securely.</h1><p>Enter your registered email and AutoCare will generate a short-lived reset code.</p></section><section class="auth-form-side"><div class="auth-card"><div class="eyebrow">Password reset</div><h1 class="h2">Forgot password</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" /><span asp-validation-for="Email" class="text-danger"></span></div><button class="btn btn-primary w-100">Send Reset Code</button></form><div class="text-center mt-3"><a asp-action="Login">Back to sign in</a></div></div></section></div>
