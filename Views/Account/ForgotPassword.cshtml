@model ForgotPasswordVm
@{ ViewData["Title"] = UiText.T(Context, "Forgot Password", "忘记密码", "Lupa Kata Laluan"); }
<div class="auth-wrap"><section class="auth-visual"><div class="eyebrow">@UiText.T(Context, "Account recovery", "账户恢复", "Pemulihan akaun")</div><h1>@UiText.T(Context, "Reset access securely.", "安全重设账户访问。", "Tetapkan semula akses dengan selamat.")</h1><p>@UiText.T(Context, "Enter your registered email and AutoCare will generate a short-lived reset code.", "输入注册电邮，AutoCare 会生成短期有效的重设码。", "Masukkan e-mel berdaftar dan AutoCare akan menjana kod tetapan semula sementara.")</p></section><section class="auth-form-side"><div class="auth-card"><div class="eyebrow">@UiText.T(Context, "Password reset", "密码重设", "Tetapan semula kata laluan")</div><h1 class="h2">@UiText.T(Context, "Forgot password", "忘记密码", "Lupa kata laluan")</h1><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="Email" class="form-label">@UiText.T(Context, "Email", "电邮", "E-mel")</label><input asp-for="Email" class="form-control" autocomplete="email" placeholder="name@example.com" /><span asp-validation-for="Email" class="text-danger"></span></div><button class="btn btn-primary w-100">@UiText.T(Context, "Send Reset Code", "发送重设码", "Hantar Kod Tetapan")</button></form><div class="text-center mt-3"><a asp-action="Login">@UiText.T(Context, "Back to sign in", "返回登录", "Kembali ke log masuk")</a></div></div></section></div>
