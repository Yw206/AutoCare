@model LoginVm
@{ ViewData["Title"] = UiText.T(Context, "Login", "登录", "Log Masuk"); }
<div class="auth-wrap"><section class="auth-visual"><div class="eyebrow">@UiText.T(Context, "Welcome to AutoCare", "欢迎来到 AutoCare", "Selamat datang ke AutoCare")</div><h1>@UiText.T(Context, "Your workshop journey, clearly managed.", "清楚管理您的维修流程。", "Urus perjalanan bengkel anda dengan jelas.")</h1><p>@UiText.T(Context, "Sign in to manage vehicles, reserve services, follow repairs and view invoices.", "登录以管理车辆、预约服务、追踪维修和查看发票。", "Log masuk untuk mengurus kenderaan, menempah servis, mengikuti pembaikan dan melihat invois.")</p><div class="auth-points"><div class="auth-point"><span>✓</span>@UiText.T(Context, "Secure member and Admin access", "安全会员和管理员访问", "Akses ahli dan Admin yang selamat")</div><div class="auth-point"><span>✓</span>@UiText.T(Context, "Real-time workshop progress", "实时车厂进度", "Kemajuan bengkel masa nyata")</div><div class="auth-point"><span>✓</span>@UiText.T(Context, "Stripe-hosted test payment", "Stripe 托管测试付款", "Bayaran ujian melalui Stripe")</div></div></section><section class="auth-form-side"><div class="auth-card"><div class="eyebrow">@UiText.T(Context, "Account access", "账户访问", "Akses akaun")</div><h1 class="h2">@UiText.T(Context, "Sign in", "登录", "Log masuk")</h1><p class="text-muted mb-4">@UiText.T(Context, "Enter your registered AutoCare credentials.", "输入您注册的 AutoCare 账户资料。", "Masukkan kelayakan AutoCare yang didaftarkan.")</p><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><form method="post"><div class="mb-3"><label asp-for="Email" class="form-label">@UiText.T(Context, "Email", "电邮", "E-mel")</label><input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="mb-3"><div class="d-flex justify-content-between"><label asp-for="Password" class="form-label">@UiText.T(Context, "Password", "密码", "Kata laluan")</label><a asp-action="ForgotPassword" class="small">@UiText.T(Context, "Forgot password?", "忘记密码？", "Lupa kata laluan?")</a></div><input asp-for="Password" class="form-control" placeholder="@UiText.T(Context, "Enter password", "输入密码", "Masukkan kata laluan")" autocomplete="current-password" /><span asp-validation-for="Password" class="text-danger"></span></div>@if(ViewBag.RequireCaptcha == true){<div class="mb-3"><label asp-for="CaptchaAnswer" class="form-label">@UiText.T(Context, "Captcha:", "验证码：", "Captcha:") @ViewBag.CaptchaQuestion</label><input asp-for="CaptchaAnswer" class="form-control" inputmode="numeric" autocomplete="off" placeholder="@UiText.T(Context, "Answer", "答案", "Jawapan")" /><span asp-validation-for="CaptchaAnswer" class="text-danger"></span></div>}<button class="btn btn-primary w-100">@UiText.T(Context, "Sign In", "登录", "Log Masuk")</button></form><div class="text-center mt-3">@UiText.T(Context, "New to AutoCare?", "AutoCare 新用户？", "Baru di AutoCare?") <a asp-action="Register">@UiText.T(Context, "Create an account", "创建账户", "Cipta akaun")</a></div><div class="auth-note mt-4"><strong>@UiText.T(Context, "Demonstration accounts", "演示账户", "Akaun demonstrasi")</strong><br />Admin: admin@autocare.com / Admin123!<br />User: user@autocare.com / User123!</div></div></section></div>
