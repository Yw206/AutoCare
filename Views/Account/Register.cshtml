@model RegisterVm
@{ ViewData["Title"] = UiText.T(Context, "Create Account", "创建账户", "Cipta Akaun"); }
<div class="auth-wrap"><section class="auth-visual"><div class="eyebrow">@UiText.T(Context, "Member registration", "会员注册", "Pendaftaran ahli")</div><h1>@UiText.T(Context, "Get started with better vehicle care.", "开始更好的车辆保养。", "Mulakan penjagaan kenderaan yang lebih baik.")</h1><p>@UiText.T(Context, "Create your account, verify your email and begin managing workshop services online.", "创建账户、验证电邮，并开始在线管理维修服务。", "Cipta akaun, sahkan e-mel dan mula mengurus servis bengkel secara dalam talian.")</p><div class="auth-points"><div class="auth-point"><span>1</span>@UiText.T(Context, "Create your member profile", "创建会员资料", "Cipta profil ahli")</div><div class="auth-point"><span>2</span>@UiText.T(Context, "Verify your email using OTP", "使用 OTP 验证电邮", "Sahkan e-mel menggunakan OTP")</div><div class="auth-point"><span>3</span>@UiText.T(Context, "Add a vehicle and book service", "添加车辆并预约服务", "Tambah kenderaan dan tempah servis")</div></div></section><section class="auth-form-side"><div class="auth-card"><div class="eyebrow">@UiText.T(Context, "New member", "新会员", "Ahli baru")</div><h1 class="h2">@UiText.T(Context, "Create your account", "创建您的账户", "Cipta akaun anda")</h1><p class="text-muted mb-4">@UiText.T(Context, "All fields marked by validation must be completed correctly.", "所有验证字段都必须正确填写。", "Semua medan validasi mesti dilengkapkan dengan betul.")</p><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="FullName">@UiText.T(Context, "Full name", "姓名", "Nama penuh")</label><input asp-for="FullName" class="form-control" placeholder="@UiText.T(Context, "Full name", "姓名", "Nama penuh")" /><span asp-validation-for="FullName" class="text-danger"></span></div><div class="row"><div class="col-md-7 mb-3"><label asp-for="Email">@UiText.T(Context, "Email", "电邮", "E-mel")</label><input asp-for="Email" class="form-control" placeholder="name@example.com" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-5 mb-3"><label asp-for="Phone">@UiText.T(Context, "Phone", "电话", "Telefon")</label><input asp-for="Phone" class="form-control" placeholder="@UiText.T(Context, "Phone number", "电话号码", "Nombor telefon")" /><span asp-validation-for="Phone" class="text-danger"></span></div></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="Password">@UiText.T(Context, "Password", "密码", "Kata laluan")</label><input asp-for="Password" class="form-control" placeholder="@UiText.T(Context, "Create password", "创建密码", "Cipta kata laluan")" /><span asp-validation-for="Password" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="ConfirmPassword">@UiText.T(Context, "Confirm password", "确认密码", "Sahkan kata laluan")</label><input asp-for="ConfirmPassword" class="form-control" placeholder="@UiText.T(Context, "Repeat password", "重复密码", "Ulang kata laluan")" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div></div><button class="btn btn-primary w-100">@UiText.T(Context, "Create Account & Verify Email", "创建账户并验证电邮", "Cipta Akaun & Sahkan E-mel")</button></form><div class="text-center mt-3">@UiText.T(Context, "Already registered?", "已经注册？", "Sudah berdaftar?") <a asp-action="Login">@UiText.T(Context, "Sign in", "登录", "Log masuk")</a></div></div></section></div>
