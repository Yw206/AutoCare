@model ChangePasswordVm
@{ ViewData["Title"] = UiText.T(Context, "Change Password", "更改密码", "Tukar Kata Laluan"); }
<div class="page-heading"><div><div class="eyebrow">@UiText.T(Context, "Security", "安全", "Keselamatan")</div><h1>@UiText.T(Context, "Change Password", "更改密码", "Tukar Kata Laluan")</h1><p>@UiText.T(Context, "Confirm your current password before setting a new one.", "设置新密码前，请确认当前密码。", "Sahkan kata laluan semasa sebelum menetapkan yang baru.")</p></div></div>
<form method="post" class="panel form-panel" style="max-width:680px"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-3"><label asp-for="CurrentPassword" class="form-label">@UiText.T(Context, "Current password", "当前密码", "Kata laluan semasa")</label><input asp-for="CurrentPassword" class="form-control" /><span asp-validation-for="CurrentPassword" class="text-danger"></span></div><div class="mb-3"><label asp-for="NewPassword" class="form-label">@UiText.T(Context, "New password", "新密码", "Kata laluan baru")</label><input asp-for="NewPassword" class="form-control" /><span asp-validation-for="NewPassword" class="text-danger"></span></div><div class="mb-3"><label asp-for="ConfirmPassword" class="form-label">@UiText.T(Context, "Confirm password", "确认密码", "Sahkan kata laluan")</label><input asp-for="ConfirmPassword" class="form-control" /><span asp-validation-for="ConfirmPassword" class="text-danger"></span></div><div class="quick-actions"><button class="btn btn-primary">@UiText.T(Context, "Update Password", "更新密码", "Kemas Kini Kata Laluan")</button><a class="btn btn-outline-secondary" asp-action="Profile">@UiText.T(Context, "Cancel", "取消", "Batal")</a></div></form>
