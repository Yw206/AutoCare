@{ ViewData["Title"] = UiText.T(Context, "Access Denied", "拒绝访问", "Akses Ditolak"); }
<div class="auth-wrap"><section class="auth-visual"><div class="eyebrow">@UiText.T(Context, "Protected area", "受保护区域", "Kawasan dilindungi")</div><h1>@UiText.T(Context, "This page belongs to another system role.", "此页面属于另一个系统角色。", "Halaman ini milik peranan sistem lain.")</h1><p>@UiText.T(Context, "AutoCare separates Member and Admin functions to protect workshop information.", "AutoCare 区分会员和管理员功能以保护车厂资料。", "AutoCare memisahkan fungsi Ahli dan Admin untuk melindungi maklumat bengkel.")</p></section><section class="auth-form-side"><div class="auth-card text-center"><div class="metric-icon red mx-auto mb-3">!</div><h1 class="h2">@UiText.T(Context, "Access denied", "拒绝访问", "Akses ditolak")</h1><p class="text-muted">@UiText.T(Context, "Your account does not have permission to open this page.", "您的账户没有权限打开此页面。", "Akaun anda tiada kebenaran membuka halaman ini.")</p><a class="btn btn-primary" asp-controller="Home" asp-action="Index">@UiText.T(Context, "Return to AutoCare", "返回 AutoCare", "Kembali ke AutoCare")</a></div></section></div>
