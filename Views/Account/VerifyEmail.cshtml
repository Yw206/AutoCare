@model VerifyEmailVm
@{ ViewData["Title"] = "Verify Email"; }
<div class="auth-wrap"><section class="auth-visual"><div class="eyebrow">Account security</div><h1>One final step to protect your account.</h1><p>AutoCare uses email verification to confirm new member accounts before login.</p></section><section class="auth-form-side"><div class="auth-card text-center"><div class="metric-icon orange mx-auto mb-3">✉</div><h1 class="h2">Verify your email</h1><p class="text-muted">Enter the six-digit code sent to <strong>@Model.Email</strong>. The code expires after 10 minutes.</p>@if(TempData["DevelopmentOtp"] != null){<div class="app-alert danger text-start"><span>!</span><div><strong>Development OTP:</strong> @TempData["DevelopmentOtp"]</div></div>}<form method="post"><input asp-for="Email" type="hidden" /><div class="mb-3 text-start"><label asp-for="Otp">Verification code</label><input asp-for="Otp" class="form-control otp-input" inputmode="numeric" maxlength="6" placeholder="000000" autocomplete="one-time-code" /><span asp-validation-for="Otp" class="text-danger"></span></div><button class="btn btn-primary w-100">Verify Email</button></form><form asp-action="ResendVerification" method="post" class="mt-3"><input type="hidden" name="email" value="@Model.Email" /><button class="btn btn-link">Send a new code</button></form></div></section></div>
