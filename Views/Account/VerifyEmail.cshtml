@model VerifyEmailVm
@{ ViewData["Title"] = UiText.T(Context, "Verify Email", "验证电邮", "Sahkan E-mel"); }
<div class="auth-wrap"><section class="auth-visual"><div class="eyebrow">@UiText.T(Context, "Account security", "账户安全", "Keselamatan akaun")</div><h1>@UiText.T(Context, "One final step to protect your account.", "保护账户的最后一步。", "Satu langkah terakhir untuk melindungi akaun anda.")</h1><p>@UiText.T(Context, "AutoCare uses email verification to confirm new member accounts before login.", "AutoCare 会在登录前验证新会员电邮。", "AutoCare menggunakan pengesahan e-mel sebelum ahli baru log masuk.")</p></section><section class="auth-form-side"><div class="auth-card text-center"><div class="metric-icon orange mx-auto mb-3">✉</div><h1 class="h2">@UiText.T(Context, "Verify your email", "验证您的电邮", "Sahkan e-mel anda")</h1><p class="text-muted">@UiText.T(Context, "Enter the six-digit code sent to", "输入发送到", "Masukkan kod enam digit yang dihantar ke") <strong>@Model.Email</strong>. @UiText.T(Context, "The code expires after 10 minutes.", "验证码 10 分钟后过期。", "Kod tamat tempoh selepas 10 minit.")</p>@if(TempData["DevelopmentOtp"] != null){<div class="app-alert danger text-start"><span>!</span><div><strong>Development OTP:</strong> @TempData["DevelopmentOtp"]</div></div>}<form method="post"><input asp-for="Email" type="hidden" /><div class="mb-3 text-start"><label asp-for="Otp">@UiText.T(Context, "Verification code", "验证码", "Kod pengesahan")</label><input asp-for="Otp" class="form-control otp-input" inputmode="numeric" maxlength="6" placeholder="000000" autocomplete="one-time-code" /><span asp-validation-for="Otp" class="text-danger"></span></div><button class="btn btn-primary w-100">@UiText.T(Context, "Verify Email", "验证电邮", "Sahkan E-mel")</button></form><form asp-action="ResendVerification" method="post" class="mt-3"><input type="hidden" name="email" value="@Model.Email" /><button class="btn btn-link">@UiText.T(Context, "Send a new code", "发送新验证码", "Hantar kod baru")</button></form></div></section></div>
