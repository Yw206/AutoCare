@model IEnumerable<AppUser>
@{ ViewData["Title"] = "Member Accounts"; }
<div class="page-heading"><div><div class="eyebrow">Access control</div><h1>Member Accounts</h1><p>Review email verification and block or unblock member access.</p></div></div><section class="panel"><div class="panel-header"><div><h2 class="panel-title">Registered Members</h2><div class="panel-subtitle">Only Admin can change an account’s access status</div></div><span class="status-badge">@Model.Count() members</span></div><div class="table-responsive"><table class="table data-table"><thead><tr><th>Member</th><th>Contact</th><th>Email Verification</th><th>Account Status</th><th>Created</th><th>Control</th></tr></thead><tbody>@foreach(var user in Model){<tr><td><strong>@user.FullName</strong><br /><small class="text-muted">Member #@user.Id</small></td><td>@user.Email<br /><small class="text-muted">@(user.Phone ?? "No phone")</small></td><td><span class="status-badge @(user.IsEmailVerified ? "Active" : "Pending")">@(user.IsEmailVerified ? "Verified" : "Not Verified")</span></td><td><span class="status-badge @(user.IsActive ? "Active" : "Inactive")">@(user.IsActive ? "Active" : "Blocked")</span></td><td>@user.CreatedAt.ToString("dd MMM yyyy")</td><td><form asp-action="ToggleUser" method="post"><input type="hidden" name="id" value="@user.Id" /><button class="btn btn-sm @(user.IsActive ? "btn-outline-danger" : "btn-success")" onclick="return confirm('Change access status for this member?')">@(user.IsActive ? "Block Account" : "Unblock Account")</button></form></td></tr>}</tbody></table></div></section>
