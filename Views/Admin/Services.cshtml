@model IEnumerable<WorkshopService>
@{ ViewData["Title"] = "Service Management"; }
<div class="page-heading"><div><div class="eyebrow">Workshop configuration</div><h1>Service Management</h1><p>Create services displayed in the member catalogue.</p></div></div><section class="panel mb-4"><div class="panel-header"><div><h2 class="panel-title">Add Workshop Service</h2><div class="panel-subtitle">Price and duration are estimates shown to members</div></div></div><form asp-action="SaveService" method="post" class="row g-3 align-items-end"><div class="col-lg-3"><label class="form-label">Service name</label><input name="Name" placeholder="e.g. Engine Oil Service" class="form-control" required /></div><div class="col-lg-3"><label class="form-label">Description</label><input name="Description" placeholder="Short service description" class="form-control" /></div><div class="col-lg-2"><label class="form-label">Estimated price</label><div class="input-group"><span class="input-group-text">RM</span><input name="EstimatedPrice" type="number" step=".01" min="0" class="form-control" required /></div></div><div class="col-lg-2"><label class="form-label">Duration</label><div class="input-group"><input name="EstimatedMinutes" type="number" min="15" class="form-control" required /><span class="input-group-text">min</span></div></div><input type="hidden" name="IsActive" value="true" /><div class="col-lg-2"><button class="btn btn-primary w-100">Add Service</button></div></form></section><section class="panel"><div class="panel-header"><div><h2 class="panel-title">Service Catalogue</h2><div class="panel-subtitle">@Model.Count() workshop services</div></div></div><div class="table-responsive"><table class="table data-table"><thead><tr><th>Service</th><th>Description</th><th>Estimated Price</th><th>Duration</th><th>Status</th></tr></thead><tbody>@foreach(var service in Model){<tr><td><strong>@service.Name</strong></td><td>@service.Description</td><td>RM @service.EstimatedPrice.ToString("N2")</td><td>@service.EstimatedMinutes min</td><td><span class="status-badge @(service.IsActive ? "Active" : "Inactive")">@(service.IsActive ? "Active" : "Inactive")</span></td></tr>}</tbody></table></div></section>
