@model IEnumerable<Appointment>
@{
    ViewData["Title"] = UiText.T(Context, "Appointments", "预约", "Janji Temu");
    var saved = ViewBag.SavedServices as IEnumerable<SavedService> ?? Enumerable.Empty<SavedService>();
    var calendar = ViewBag.Calendar as IEnumerable<Appointment> ?? Enumerable.Empty<Appointment>();
}
<div class="page-heading">
    <div><div class="eyebrow">@UiText.T(Context, "Workshop bookings", "车厂预约", "Tempahan bengkel")</div><h1>@UiText.T(Context, "Appointments", "预约", "Janji Temu")</h1><p>@UiText.T(Context, "Review bookings, saved services and workshop decisions.", "查看预约、收藏服务和车厂决定。", "Semak tempahan, servis disimpan dan keputusan bengkel.")</p></div>
    <a class="btn btn-primary" asp-action="Create">＋ @UiText.T(Context, "New Appointment", "新预约", "Janji Temu Baru")</a>
</div>
<section class="panel mb-4">
    <div class="panel-header"><div><h2 class="panel-title">@UiText.T(Context, "Time-Slot Calendar", "时段日历", "Kalendar Slot Masa")</h2><div class="panel-subtitle">@UiText.T(Context, "Upcoming and recent booking schedule", "即将到来和最近的预约时间表", "Jadual tempahan akan datang dan terkini")</div></div></div>
    @if (!calendar.Any()) { <div class="empty-state py-3"><p class="mb-0">@UiText.T(Context, "No appointment appears in the calendar yet.", "日历中还没有预约。", "Tiada janji temu dalam kalendar lagi.")</p></div> }
    else { <div class="calendar-strip">@foreach (var item in calendar) { <div class="calendar-tile calendar-status-@item.Status"><strong>@item.AppointmentAt.ToString("dd MMM")</strong><span>@item.AppointmentAt.ToString("hh:mm tt")</span><small>@item.WorkshopService?.Name</small><em class="@item.Status">@item.Status</em></div> }</div> }
</section>
<section class="panel mb-4">
    <div class="panel-header"><div><h2 class="panel-title">@UiText.T(Context, "Saved Service List", "收藏服务列表", "Senarai Servis Disimpan")</h2><div class="panel-subtitle">@UiText.T(Context, "Wishlist Transfer: move a saved service directly into appointment booking", "愿望清单转预约：直接把收藏服务转成预约", "Pindah senarai hasrat terus ke tempahan janji temu")</div></div><a asp-controller="Services" asp-action="Index">@UiText.T(Context, "Browse services", "浏览服务", "Layari servis")</a></div>
    @if (!saved.Any()) { <div class="empty-state py-3"><p class="mb-0">@UiText.T(Context, "No saved service yet.", "还没有收藏服务。", "Tiada servis disimpan lagi.")</p></div> }
    else { <div class="row g-3">@foreach (var item in saved) { <div class="col-md-6"><div class="auth-note d-flex justify-content-between align-items-center gap-3"><div><strong>@item.WorkshopService?.Name</strong><div>@UiText.T(Context, "Saved", "收藏于", "Disimpan") @item.SavedAt.ToString("dd MMM yyyy")</div>@if (!string.IsNullOrWhiteSpace(item.Note)) { <small class="text-muted">@UiText.T(Context, "Note:", "备注：", "Nota:") @item.Note</small> }</div><a class="btn btn-primary btn-sm" asp-action="Create" asp-route-serviceId="@item.WorkshopServiceId">@UiText.T(Context, "Transfer to Booking", "转为预约", "Pindah ke Tempahan")</a></div></div> }</div> }
</section>
<section class="panel">
    <div class="panel-header"><div><h2 class="panel-title">@UiText.T(Context, "Booking History", "预约记录", "Sejarah Tempahan")</h2><div class="panel-subtitle">@UiText.T(Context, "Your active and previous service appointments", "您的当前和历史服务预约", "Janji temu servis aktif dan terdahulu anda")</div></div></div>
    @if (!Model.Any()) { <div class="empty-state"><div class="empty-icon">▦</div><h3 class="h6">@UiText.T(Context, "No appointments", "没有预约", "Tiada janji temu")</h3><p>@UiText.T(Context, "Your bookings will be listed here.", "您的预约会显示在这里。", "Tempahan anda akan disenaraikan di sini.")</p></div> }
    else
    {
        <div class="table-responsive"><table class="table data-table"><thead><tr><th>@UiText.T(Context, "Date & Time", "日期与时间", "Tarikh & Masa")</th><th>@UiText.T(Context, "Vehicle", "车辆", "Kenderaan")</th><th>@UiText.T(Context, "Service", "服务", "Servis")</th><th>@UiText.T(Context, "Problem", "问题", "Masalah")</th><th>@UiText.T(Context, "Status", "状态", "Status")</th><th>@UiText.T(Context, "Action", "操作", "Tindakan")</th></tr></thead><tbody>
        @foreach (var appointment in Model)
        {
            <tr>
                <td><strong>@appointment.AppointmentAt.ToString("dd MMM yyyy")</strong><br /><small class="text-muted">@appointment.AppointmentAt.ToString("hh:mm tt")</small></td>
                <td>@appointment.Vehicle?.RegistrationNumber</td>
                <td>@appointment.WorkshopService?.Name</td>
                <td style="max-width:260px">@appointment.ProblemDescription@if (!string.IsNullOrWhiteSpace(appointment.AdminRemark)) { <div class="small text-muted mt-1">@UiText.T(Context, "Admin:", "管理员：", "Admin:") @appointment.AdminRemark</div> }</td>
                <td><span class="status-badge @appointment.Status">@appointment.Status</span></td>
                <td><div class="quick-actions">@if (appointment.Status == AppointmentStatus.Pending) { <form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@appointment.Id" /><button class="btn btn-outline-danger btn-sm" onclick="return confirm('@UiText.T(Context, "Cancel this appointment?", "取消这个预约？", "Batalkan janji temu ini?")')">@UiText.T(Context, "Cancel", "取消", "Batal")</button></form> }@if (appointment.AppointmentAt > DateTime.Now && !appointment.ReminderSent) { <form asp-action="SendReminder" method="post"><input type="hidden" name="id" value="@appointment.Id" /><button class="btn btn-outline-primary btn-sm">@UiText.T(Context, "Send Reminder", "发送提醒", "Hantar Peringatan")</button></form> }@if (appointment.Status != AppointmentStatus.Pending && (appointment.AppointmentAt <= DateTime.Now || appointment.ReminderSent)) { <span class="text-muted">-</span> }</div></td>
            </tr>
        }
        </tbody></table></div>
    }
</section>
