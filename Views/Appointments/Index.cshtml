@model IEnumerable<Appointment>
@{ ViewData["Title"] = "Appointments"; var saved = ViewBag.SavedServices as IEnumerable<SavedService> ?? Enumerable.Empty<SavedService>(); var calendar = ViewBag.Calendar as IEnumerable<Appointment> ?? Enumerable.Empty<Appointment>(); }
<div class="page-heading"><div><div class="eyebrow">Workshop bookings</div><h1>Appointments</h1><p>Review bookings, saved services and workshop decisions.</p></div><a class="btn btn-primary" asp-action="Create">＋ New Appointment</a></div>
<section class="panel mb-4"><div class="panel-header"><div><h2 class="panel-title">Time-Slot Calendar</h2><div class="panel-subtitle">Upcoming and recent booking schedule</div></div></div>@if(!calendar.Any()){<div class="empty-state py-3"><p class="mb-0">No appointment appears in the calendar yet.</p></div>}else{<div class="calendar-strip">@foreach(var item in calendar){<div class="calendar-tile"><strong>@item.AppointmentAt.ToString("dd MMM")</strong><span>@item.AppointmentAt.ToString("hh:mm tt")</span><small>@item.WorkshopService?.Name</small><em class="@item.Status">@item.Status</em></div>}</div>}</section>
<section class="panel mb-4"><div class="panel-header"><div><h2 class="panel-title">Saved Service List</h2><div class="panel-subtitle">Wishlist Transfer: move a saved service directly into appointment booking</div></div><a asp-controller="Services" asp-action="Index">Browse services</a></div>@if(!saved.Any()){<div class="empty-state py-3"><p class="mb-0">No saved service yet.</p></div>}else{<div class="row g-3">@foreach(var item in saved){<div class="col-md-6"><div class="auth-note d-flex justify-content-between align-items-center gap-3"><div><strong>@item.WorkshopService?.Name</strong><div>Saved @item.SavedAt.ToString("dd MMM yyyy")</div>@if(!string.IsNullOrWhiteSpace(item.Note)){<small class="text-muted">Note: @item.Note</small>}</div><a class="btn btn-primary btn-sm" asp-action="Create" asp-route-serviceId="@item.WorkshopServiceId">Transfer to Booking</a></div></div>}</div>}</section>
<section class="panel"><div class="panel-header"><div><h2 class="panel-title">Booking History</h2><div class="panel-subtitle">Your active and previous service appointments</div></div></div>@if(!Model.Any()){<div class="empty-state"><div class="empty-icon">▦</div><h3 class="h6">No appointments</h3><p>Your bookings will be listed here.</p></div>}else{<div class="table-responsive"><table class="table data-table"><thead><tr><th>Date & Time</th><th>Vehicle</th><th>Service</th><th>Problem</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach(var appointment in Model){<tr><td><strong>@appointment.AppointmentAt.ToString("dd MMM yyyy")</strong><br /><small class="text-muted">@appointment.AppointmentAt.ToString("hh:mm tt")</small></td><td>@appointment.Vehicle?.RegistrationNumber</td><td>@appointment.WorkshopService?.Name</td><td style="max-width:260px">@appointment.ProblemDescription@if(!string.IsNullOrWhiteSpace(appointment.AdminRemark)){<div class="small text-muted mt-1">Admin: @appointment.AdminRemark</div>}</td><td><span class="status-badge @appointment.Status">@appointment.Status</span></td><td><div class="quick-actions">@if(appointment.Status == AppointmentStatus.Pending){<form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@appointment.Id" /><button class="btn btn-outline-danger btn-sm" onclick="return confirm('Cancel this appointment?')">Cancel</button></form>}@if(appointment.AppointmentAt > DateTime.Now && !appointment.ReminderSent){<form asp-action="SendReminder" method="post"><input type="hidden" name="id" value="@appointment.Id" /><button class="btn btn-outline-primary btn-sm">Send Reminder</button></form>}@if(appointment.Status != AppointmentStatus.Pending && (appointment.AppointmentAt <= DateTime.Now || appointment.ReminderSent)){<span class="text-muted">—</span>}</div></td></tr>}</tbody></table></div>}</section>
