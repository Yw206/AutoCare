@model AppointmentVm
@{ ViewData["Title"] = "Book Service"; }
<div class="page-heading"><div><div class="eyebrow">New booking</div><h1>Book Workshop Service</h1><p>Select your vehicle, service and preferred appointment time.</p></div></div>
<div class="dashboard-grid"><form method="post" class="panel form-panel"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="form-section"><h3>1. Vehicle and service</h3><div class="row"><div class="col-md-6 mb-3"><label asp-for="VehicleId">Your vehicle</label><select asp-for="VehicleId" asp-items="ViewBag.Vehicles" class="form-select"><option value="">Select vehicle</option></select><span asp-validation-for="VehicleId" class="text-danger"></span></div><div class="col-md-6 mb-3"><label asp-for="WorkshopServiceId">Workshop service</label><select asp-for="WorkshopServiceId" asp-items="ViewBag.Services" class="form-select"><option value="">Select service</option></select><span asp-validation-for="WorkshopServiceId" class="text-danger"></span></div></div></div><div class="form-section"><h3>2. Preferred schedule</h3><div class="row align-items-end"><div class="col-md-7 mb-3"><label asp-for="AppointmentAt">Date and time</label><input asp-for="AppointmentAt" class="form-control" /><span asp-validation-for="AppointmentAt" class="text-danger"></span></div><div class="col-md-5 mb-3"><button type="button" id="checkAvailability" class="btn btn-outline-primary w-100">Check Availability</button></div></div><div id="availabilityResult" class="app-alert d-none"></div></div><div class="form-section"><h3>3. Vehicle concern</h3><label asp-for="ProblemDescription">Describe the problem or requested work</label><textarea asp-for="ProblemDescription" class="form-control" rows="5" placeholder="Tell the workshop what you noticed or what service you need..."></textarea><span asp-validation-for="ProblemDescription" class="text-danger"></span></div><div class="quick-actions mt-3"><button class="btn btn-primary">Submit Appointment</button><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a></div></form><aside class="panel align-self-start"><h2 class="panel-title">Before submitting</h2><div class="form-section"><strong>Workshop hours</strong><p class="text-muted mb-0">Appointments are available from 8:00 AM to 6:00 PM.</p></div><div class="form-section"><strong>Availability checking</strong><p class="text-muted mb-0">The selected slot is checked instantly and checked again when submitted.</p></div><div class="form-section"><strong>Admin confirmation</strong><p class="text-muted mb-0">A pending booking becomes confirmed after Admin approval.</p></div></aside></div>
@section Scripts {<script>const appointmentInput=document.getElementById('AppointmentAt'),serviceInput=document.getElementById('WorkshopServiceId');document.getElementById('checkAvailability').addEventListener('click',async function(){const date=appointmentInput.value;const service=serviceInput.value;const box=document.getElementById('availabilityResult');box.classList.remove('d-none','success','danger');if(!date||!service){box.classList.add('danger');box.innerHTML='<span>!</span><div>Select a service, date and time first.</div>';return;}this.disabled=true;this.textContent='Checking...';try{const response=await fetch(`/Appointments/CheckAvailability?appointmentAt=${encodeURIComponent(date)}&serviceId=${encodeURIComponent(service)}`);const result=await response.json();box.classList.add(result.available?'success':'danger');box.innerHTML=`<span>${result.available?'✓':'!'}</span><div>${result.message}</div>`;}catch{box.classList.add('danger');box.innerHTML='<span>!</span><div>Availability could not be checked. Please try again.</div>';}finally{this.disabled=false;this.textContent='Check Availability';}});appointmentInput.addEventListener('change',async()=>{if(!appointmentInput.value||!serviceInput.value)return;const day=appointmentInput.value.substring(0,10);const response=await fetch(`/Appointments/AvailableSlots?date=${encodeURIComponent(day)}&serviceId=${encodeURIComponent(serviceInput.value)}`);const slots=await response.json();const box=document.getElementById('availabilityResult');box.classList.remove('d-none','danger');box.classList.add('success');box.innerHTML='<span>✓</span><div><strong>Daily slot view:</strong> '+slots.map(s=>`${s.label} ${s.available?'available':'booked'}`).join(' · ')+'</div>';});</script>}
