@model IEnumerable<WorkshopService>
@{ var saved=(ViewBag.SavedIds as IEnumerable<int>)?.ToHashSet()??new HashSet<int>();int currentPage=ViewBag.CurrentPage;int totalPages=ViewBag.TotalPages;int totalItems=ViewBag.TotalItems; }
<div class="d-flex justify-content-between align-items-center mb-3"><strong>@totalItems service(s) found</strong><span class="text-muted small">Page @currentPage of @totalPages</span></div>
@if(!Model.Any()){<div class="panel empty-state"><div class="empty-icon">⌕</div><h3 class="h6">No matching service</h3><p>Try another search term.</p></div>}else{<div class="row g-3">@foreach(var service in Model){<div class="col-lg-4 col-md-6"><article class="service-card d-flex flex-column"><div class="service-icon">⚙</div><h3>@service.Name</h3><p class="text-muted">@service.Description</p><div class="mt-auto"><div class="d-flex justify-content-between align-items-end mb-3"><div><small class="text-muted">Estimated from</small><div class="service-price">RM @service.EstimatedPrice.ToString("N2")</div></div><span class="status-badge">@service.EstimatedMinutes min</span></div><div class="quick-actions">@if(saved.Contains(service.Id)){<form asp-action="Remove" method="post"><input type="hidden" name="serviceId" value="@service.Id" /><button class="btn btn-outline-danger btn-sm">Remove Saved</button></form>}else{<form asp-action="Save" method="post" class="save-note-form"><input type="hidden" name="serviceId" value="@service.Id" /><input name="note" class="form-control form-control-sm" maxlength="300" placeholder="Optional saved note" /><button class="btn btn-outline-primary btn-sm">♡ Save Service</button></form>}<a class="btn btn-primary btn-sm" asp-controller="Appointments" asp-action="Create" asp-route-serviceId="@service.Id">Book Now</a></div></div></article></div>}</div>}
@if(totalPages>1){<nav class="ajax-pagination mt-4" aria-label="Service pages"><button type="button" class="btn btn-outline-secondary btn-sm" data-page="@(currentPage-1)" disabled="@(currentPage==1?"disabled":null)">Previous</button>@for(int pageNumber=1;pageNumber<=totalPages;pageNumber++){<button type="button" class="btn btn-sm @(pageNumber==currentPage?"btn-primary":"btn-outline-secondary")" data-page="@pageNumber">@pageNumber</button>}<button type="button" class="btn btn-outline-secondary btn-sm" data-page="@(currentPage+1)" disabled="@(currentPage==totalPages?"disabled":null)">Next</button></nav>}
