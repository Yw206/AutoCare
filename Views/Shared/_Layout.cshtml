@using AutoCare.Data
@inject AppDbContext Db
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var isAdmin = authenticated && User.IsInRole("Admin");
    var homeController = isAdmin ? "Admin" : "Dashboard";
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    string Active(string targetController, string? targetAction = null) => controller.Equals(targetController, StringComparison.OrdinalIgnoreCase) && (targetAction == null || action.Equals(targetAction, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
    string Initials()
    {
        var words = (User.Identity?.Name ?? "AutoCare User").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return string.Concat(words.Take(2).Select(x => char.ToUpperInvariant(x[0])));
    }
    var currentUserId = authenticated ? int.Parse(User.FindFirstValue(ClaimTypes.NameIdentifier)!) : 0;
    var notifications = authenticated ? Db.Notifications.Where(x => x.UserId == currentUserId).OrderByDescending(x => x.CreatedAt).Take(5).ToList() : new List<Notification>();
    var unreadCount = notifications.Count(x => !x.IsRead);
    var chatUnreadCount = authenticated ? (isAdmin
        ? Db.ChatMessages.Count(x => x.SenderRole == ChatSenderRole.User && (!x.ChatThread!.AdminLastReadAt.HasValue || x.SentAt > x.ChatThread.AdminLastReadAt.Value))
        : Db.ChatMessages.Count(x => x.ChatThread!.UserId == currentUserId && x.SenderRole == ChatSenderRole.Admin && (!x.ChatThread.UserLastReadAt.HasValue || x.SentAt > x.ChatThread.UserLastReadAt.Value))) : 0;
    var profile = authenticated ? Db.Users.Where(x => x.Id == currentUserId).Select(x => new { x.ProfilePhotoPath, x.ThemePreference, x.LanguagePreference }).FirstOrDefault() : null;
    var profilePhoto = profile?.ProfilePhotoPath;
    var themeClass = profile?.ThemePreference == "dark" ? "theme-dark" : "theme-light";
    var language = profile?.LanguagePreference ?? Context.Request.Cookies["AutoCare.Language"] ?? "en";
    language = language is "zh" or "ms" ? language : "en";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    string T(string en, string zh, string ms) => language switch { "zh" => zh, "ms" => ms, _ => en };
}
<!DOCTYPE html>
<html lang="@language">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - AutoCare</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(authenticated ? $"app-body {themeClass} {(isAdmin ? "admin-theme" : "user-theme")}" : "public-body")">
@if (authenticated)
{
    <div class="mobile-backdrop" id="mobileBackdrop"></div>
    <aside class="app-sidebar" id="appSidebar" aria-label="Primary navigation">
        <a class="brand" asp-controller="@homeController" asp-action="Index"><span class="brand-mark">A</span><span>Auto<span>Care</span></span></a>
        <div class="role-label">@(isAdmin ? T("Workshop Administration", "维修厂管理", "Pentadbiran Bengkel") : T("Member Portal", "会员门户", "Portal Ahli"))</div>
        <nav class="sidebar-nav">
        @if (isAdmin)
        {
            <a class="@Active("Admin", "Index")" asp-controller="Admin" asp-action="Index"><span class="nav-icon">⌂</span><span>@T("Dashboard", "仪表板", "Papan Pemuka")</span></a>
            <a class="@Active("Admin", "Services")" asp-controller="Admin" asp-action="Services"><span class="nav-icon">⚙</span><span>@T("Services", "服务", "Servis")</span></a>
            <a class="@Active("Admin", "Parts")" asp-controller="Admin" asp-action="Parts"><span class="nav-icon">▣</span><span>@T("Inventory", "库存", "Inventori")</span></a>
            <a class="@Active("Admin", "Reports")" asp-controller="Admin" asp-action="Reports"><span class="nav-icon">▤</span><span>@T("Reports", "报告", "Laporan")</span></a>
            <a class="@Active("Admin", "Users")" asp-controller="Admin" asp-action="Users"><span class="nav-icon">♟</span><span>@T("Member Accounts", "会员账号", "Akaun Ahli")</span></a>
            <a class="@Active("Admin", "AuditLogs")" asp-controller="Admin" asp-action="AuditLogs"><span class="nav-icon">◇</span><span>@T("Audit Logs", "审核记录", "Log Audit")</span></a>
            <a class="@Active("SupportChat")" asp-controller="SupportChat" asp-action="Admin"><span class="nav-icon">☏</span><span>@T("Customer Chats", "客户聊天", "Sembang Pelanggan")</span>@if(chatUnreadCount > 0){<span class="nav-count">@chatUnreadCount</span>}</a>
            <a class="@Active("Community")" asp-controller="Community" asp-action="Index"><span class="nav-icon">✦</span><span>@T("Community", "社区", "Komuniti")</span></a>
            <a class="@Active("Home", "Location")" asp-controller="Home" asp-action="Location"><span class="nav-icon">⌖</span><span>@T("Workshop Location", "维修厂位置", "Lokasi Bengkel")</span></a>
        }
        else
        {
            <a class="@Active("Dashboard")" asp-controller="Dashboard" asp-action="Index"><span class="nav-icon">⌂</span><span>@T("Dashboard", "仪表板", "Papan Pemuka")</span></a>
            <a class="@Active("Vehicles")" asp-controller="Vehicles" asp-action="Index"><span class="nav-icon">▰</span><span>@T("My Vehicles", "我的车辆", "Kenderaan Saya")</span></a>
            <a class="@Active("Services")" asp-controller="Services" asp-action="Index"><span class="nav-icon">⚙</span><span>@T("Services", "服务", "Servis")</span></a>
            <a class="@Active("Appointments")" asp-controller="Appointments" asp-action="Index"><span class="nav-icon">▦</span><span>@T("Appointments", "预约", "Janji Temu")</span></a>
            <a class="@Active("PurchaseHistory")" asp-controller="PurchaseHistory" asp-action="Index"><span class="nav-icon">▤</span><span>@T("Purchase Report", "消费报告", "Laporan Pembelian")</span></a>
            <a class="@Active("SupportChat")" asp-controller="SupportChat" asp-action="Index"><span class="nav-icon">☏</span><span>@T("Support Chat", "客服聊天", "Sembang Sokongan")</span>@if(chatUnreadCount > 0){<span class="nav-count">@chatUnreadCount</span>}</a>
            <a class="@Active("Community")" asp-controller="Community" asp-action="Index"><span class="nav-icon">✦</span><span>@T("Community", "社区", "Komuniti")</span></a>
            <a class="@Active("Home", "Location")" asp-controller="Home" asp-action="Location"><span class="nav-icon">⌖</span><span>@T("Workshop Location", "维修厂位置", "Lokasi Bengkel")</span></a>
        }
        </nav>
        <div class="sidebar-support"><span class="support-icon">?</span><div><strong>@T("Need help?", "需要帮助？", "Perlu bantuan?")</strong><small>@T("Workshop hours", "营业时间", "Waktu bengkel")<br />8:00 AM – 6:00 PM</small></div></div>
        <div class="sidebar-footer">AutoCare © @DateTime.Now.Year</div>
    </aside>
    <div class="app-shell">
        <header class="app-topbar">
            <button class="sidebar-toggle" id="sidebarToggle" type="button" aria-label="Toggle menu">☰</button>
            <div><div class="topbar-title">@ViewData["Title"]</div><div class="topbar-subtitle">@(isAdmin ? T("Workshop operations and service control", "维修厂运营与服务管理", "Operasi bengkel dan kawalan servis") : T("Manage your vehicle care in one place", "集中管理您的车辆保养", "Urus penjagaan kenderaan anda di satu tempat"))</div></div>
            <div class="topbar-user">
                <form class="language-form" asp-controller="Account" asp-action="SetLanguage" method="post"><input type="hidden" name="returnUrl" value="@returnUrl" /><select name="language" class="form-select form-select-sm" onchange="this.form.submit()" aria-label="Language"><option value="en" selected="@(language == "en")">EN</option><option value="zh" selected="@(language == "zh")">中文</option><option value="ms" selected="@(language == "ms")">BM</option></select></form>
                <details class="notification-menu"><summary>@T("Updates", "更新", "Kemas kini") @if(unreadCount > 0){<span class="notification-count">@unreadCount</span>}</summary><div class="notification-panel" id="notificationPanel">@if(!notifications.Any()){<div class="notification-item text-muted">@T("No updates yet.", "暂无更新。", "Tiada kemas kini.")</div>}@foreach(var note in notifications){<div class="notification-item"><strong>@note.Title</strong><small>@note.CreatedAt.ToString("dd MMM HH:mm") · @note.Category</small><p>@note.Message</p></div>}</div></details>
                <a class="user-avatar" asp-controller="Account" asp-action="Profile">@if(!string.IsNullOrWhiteSpace(profilePhoto)){<img src="@profilePhoto" alt="Profile" />}else{@Initials()}</a>
                <div class="user-copy"><strong>@User.Identity?.Name</strong><small>@(isAdmin ? "Administrator" : "Member")</small></div>
                <form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-secondary" type="submit">@T("Logout", "登出", "Log Keluar")</button></form>
            </div>
        </header>
        <main class="app-content">
            @if (TempData["Success"] != null) { <div class="app-alert success" role="alert"><span>✓</span><div>@TempData["Success"]</div><button type="button" data-dismiss-alert>×</button></div> }
            @if (TempData["Error"] != null) { <div class="app-alert danger" role="alert"><span>!</span><div>@TempData["Error"]</div><button type="button" data-dismiss-alert>×</button></div> }
            @RenderBody()
        </main>
    </div>
}
else
{
    <header class="public-header"><div class="container public-nav"><a class="brand public-brand" asp-controller="Home" asp-action="Index"><span class="brand-mark">A</span><span>Auto<span>Care</span></span></a><nav><a asp-controller="Home" asp-action="Index">Home</a><a asp-controller="Home" asp-action="Location">Location</a><a asp-controller="Account" asp-action="Login">Login</a><a class="btn btn-primary btn-sm" asp-controller="Account" asp-action="Register">Create Account</a></nav></div></header>
    <main class="public-main">
        @if (TempData["Success"] != null) { <div class="container pt-3"><div class="app-alert success"><span>✓</span><div>@TempData["Success"]</div></div></div> }
        @if (TempData["Error"] != null) { <div class="container pt-3"><div class="app-alert danger"><span>!</span><div>@TempData["Error"]</div></div></div> }
        @RenderBody()
    </main>
    <footer class="public-footer"><div class="container">AutoCare Vehicle Workshop Service Management System © @DateTime.Now.Year</div></footer>
}
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
<script src="~/lib/jquery-validation-unobtrusive/dist/jquery.validate.unobtrusive.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<div class="gallery-modal" id="galleryModal" aria-hidden="true"><button type="button" class="gallery-close" aria-label="Close photo preview">×</button><img alt="" /><div class="gallery-caption"></div></div>
<script>
document.querySelectorAll('[data-gallery]').forEach(link => {
    link.addEventListener('click', event => {
        event.preventDefault();
        const modal = document.getElementById('galleryModal');
        const image = modal.querySelector('img');
        modal.querySelector('.gallery-caption').textContent = link.dataset.title || 'Inspection photo';
        image.src = link.href;
        image.alt = link.querySelector('img')?.alt || 'Inspection photo';
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
    });
});
document.getElementById('galleryModal')?.addEventListener('click', event => {
    if (event.target.id === 'galleryModal' || event.target.classList.contains('gallery-close')) {
        event.currentTarget.classList.remove('open');
        event.currentTarget.setAttribute('aria-hidden', 'true');
    }
});
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
