@{ ViewData["Title"]="Workshop Location";string query=Uri.EscapeDataString((string)ViewBag.MapQuery); }
<div class="page-heading"><div><div class="eyebrow">Find the workshop</div><h1>@ViewBag.WorkshopName</h1><p>@ViewBag.WorkshopAddress</p></div><a class="btn btn-primary" target="_blank" rel="noopener" href="https://www.google.com/maps/search/?api=1&query=@query">Open Directions</a></div>
<div class="dashboard-grid"><section class="panel map-panel"><iframe title="AutoCare workshop location" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src="https://www.google.com/maps?q=@query&output=embed"></iframe></section><aside class="panel align-self-start"><h2 class="panel-title mb-3">Workshop Information</h2><div class="form-section"><strong>Address</strong><p class="text-muted mb-0">@ViewBag.WorkshopAddress</p></div><div class="form-section"><strong>Operating Hours</strong><p class="text-muted mb-0">Monday–Saturday<br />8:00 AM–6:00 PM</p></div><div class="form-section"><strong>Before visiting</strong><p class="text-muted mb-0">Members can check availability and reserve an appointment online.</p></div></aside></div>
