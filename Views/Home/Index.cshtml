@{ ViewData["Title"] = "Home"; }
<section class="hero"><div class="container"><div class="hero-copy"><div class="eyebrow">Vehicle care made clearer</div><h1>Professional workshop service, managed online.</h1><p class="my-4">Register your vehicle, reserve a service, review inspection evidence, approve quotations, follow repair updates and complete secure test payments from one responsive portal.</p><div class="d-flex flex-wrap gap-2"><a class="btn btn-primary btn-lg" asp-controller="Account" asp-action="Register">Create Member Account</a><a class="btn btn-outline-light btn-lg" asp-controller="Account" asp-action="Login">Sign In</a></div></div></div></section>
<section class="container feature-strip"><div class="row g-3">@foreach(var feature in new[]{("01","Book with confidence","Check active services and workshop availability before submitting."),("02","Follow every stage","See inspection, quotation, repair and invoice progress in one place."),("03","Secure test checkout","Use Stripe-hosted test payment and receive an email receipt.")}){<div class="col-md-4"><div class="panel h-100"><div class="eyebrow">@feature.Item1</div><h2 class="h5 fw-bold">@feature.Item2</h2><p class="text-muted mb-0">@feature.Item3</p></div></div>}</div></section>
<section class="container py-5"><div class="text-center mb-4"><div class="eyebrow">How it works</div><h2 class="fw-bold">A connected service journey</h2></div><div class="service-timeline">@foreach(var step in new[]{("1","Register"),("2","Book"),("3","Inspect"),("4","Approve"),("5","Repair"),("6","Pay")}){<div class="timeline-step done"><div class="timeline-dot">@step.Item1</div><span>@step.Item2</span></div>}</div></section>
