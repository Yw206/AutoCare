@model IEnumerable<Announcement>
@{
    ViewData["Title"] = UiText.T(Context, "Community", "社区", "Komuniti");
    var feedback = ViewBag.Feedback as IEnumerable<Feedback> ?? Enumerable.Empty<Feedback>();
    bool canReview = (ViewBag.CanReview as bool?) ?? false;
    double average = feedback.Any() ? feedback.Average(x => x.Rating) : 0;
}
<div class="page-heading"><div><div class="eyebrow">@UiText.T(Context, "Workshop communication", "车厂沟通", "Komunikasi bengkel")</div><h1>@UiText.T(Context, "Announcements & Service Reviews", "公告与服务评价", "Pengumuman & Ulasan Servis")</h1><p>@UiText.T(Context, "Read workshop updates and ratings from completed customers.", "阅读车厂更新和已完成客户的评分。", "Baca kemas kini bengkel dan penilaian pelanggan selesai.")</p></div></div>
<div class="dashboard-grid"><div class="dashboard-stack">
@if(User.IsInRole("Admin")){<section class="panel"><div class="panel-header"><div><h2 class="panel-title">@UiText.T(Context, "Publish Announcement", "发布公告", "Terbitkan Pengumuman")</h2><div class="panel-subtitle">@UiText.T(Context, "Visible to all signed-in members", "所有登录会员可见", "Dilihat oleh semua ahli log masuk")</div></div></div><form asp-action="Announcement" method="post"><div class="mb-3"><label class="form-label">@UiText.T(Context, "Title", "标题", "Tajuk")</label><input name="title" class="form-control" required /></div><div class="mb-3"><label class="form-label">@UiText.T(Context, "Message", "内容", "Mesej")</label><textarea name="content" class="form-control" rows="4" required></textarea></div><button class="btn btn-primary">@UiText.T(Context, "Publish Announcement", "发布公告", "Terbitkan Pengumuman")</button></form></section>}
<section class="panel"><div class="panel-header"><div><h2 class="panel-title">@UiText.T(Context, "Latest Announcements", "最新公告", "Pengumuman Terkini")</h2><div class="panel-subtitle">@UiText.T(Context, "Information from AutoCare Workshop", "AutoCare 车厂资讯", "Maklumat daripada Bengkel AutoCare")</div></div></div>@if(!Model.Any()){<div class="empty-state"><p>@UiText.T(Context, "No announcement is available.", "暂无公告。", "Tiada pengumuman tersedia.")</p></div>}@foreach(var announcement in Model){<article class="form-section"><div class="d-flex justify-content-between gap-3"><strong>@announcement.Title</strong><small class="text-muted text-nowrap">@announcement.PublishedAt.ToString("dd MMM yyyy")</small></div><p class="text-muted mb-0 mt-2">@announcement.Content</p></article>}</section></div>
<div class="dashboard-stack">
@if(User.IsInRole("User")){<section class="panel"><div class="panel-header"><div><h2 class="panel-title">@UiText.T(Context, "Service Review & Rating", "服务评价与评分", "Ulasan & Penilaian Servis")</h2><div class="panel-subtitle">@UiText.T(Context, "Available after a completed workshop service", "完成维修服务后可使用", "Tersedia selepas servis bengkel selesai")</div></div></div>@if(!canReview){<div class="auth-note">@UiText.T(Context, "Complete a workshop service before submitting a verified customer review.", "完成维修服务后才能提交已验证客户评价。", "Selesaikan servis bengkel sebelum menghantar ulasan pelanggan disahkan.")</div>}else{<form asp-action="Feedback" method="post"><label class="form-label">@UiText.T(Context, "Your rating", "您的评分", "Penilaian anda")</label><div class="rating-picker mb-3">@for(int star=5;star>=1;star--){<input type="radio" name="rating" id="star@star" value="@star" required /><label for="star@star" title="@star star">★</label>}</div><div class="mb-3"><label class="form-label">@UiText.T(Context, "Review", "评价", "Ulasan")</label><textarea name="comment" class="form-control" rows="4" maxlength="800" placeholder="@UiText.T(Context, "Share your service experience...", "分享您的服务体验...", "Kongsi pengalaman servis anda...")" required></textarea></div><button class="btn btn-primary">@UiText.T(Context, "Submit Review", "提交评价", "Hantar Ulasan")</button></form>}</section>}
<section class="panel"><div class="panel-header"><div><h2 class="panel-title">@UiText.T(Context, "Customer Reviews", "客户评价", "Ulasan Pelanggan")</h2><div class="panel-subtitle">@feedback.Count() @UiText.T(Context, "review(s)", "条评价", "ulasan") · @UiText.T(Context, "Average", "平均", "Purata") @average.ToString("0.0")/5</div></div><span class="status-badge">★ @average.ToString("0.0")</span></div>@if(!feedback.Any()){<div class="empty-state"><p>@UiText.T(Context, "No review has been submitted.", "还没有提交评价。", "Tiada ulasan dihantar.")</p></div>}@foreach(var item in feedback){<article class="form-section"><div class="d-flex justify-content-between"><strong>@item.User?.FullName</strong><span class="review-stars">@string.Concat(Enumerable.Repeat("★",item.Rating))@string.Concat(Enumerable.Repeat("☆",5-item.Rating))</span></div><small class="text-muted">@item.SubmittedAt.ToString("dd MMM yyyy")</small><p class="text-muted mt-2">@item.Comment</p>@if(!string.IsNullOrWhiteSpace(item.AdminResponse)){<div class="auth-note"><strong>@UiText.T(Context, "AutoCare response:", "AutoCare 回复：", "Respons AutoCare:")</strong> @item.AdminResponse</div>}@if(User.IsInRole("Admin")){<form asp-action="Respond" method="post" class="d-flex gap-2 mt-2"><input type="hidden" name="id" value="@item.Id" /><input name="response" class="form-control" maxlength="800" placeholder="@UiText.T(Context, "Write an Admin response", "填写管理员回复", "Tulis respons Admin")" required /><button class="btn btn-primary">@UiText.T(Context, "Reply", "回复", "Balas")</button></form>}</article>}</section></div></div>
