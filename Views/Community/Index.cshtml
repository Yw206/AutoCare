@model IEnumerable<Announcement>
@{ ViewData["Title"]="Community";var feedback=ViewBag.Feedback as IEnumerable<Feedback>??Enumerable.Empty<Feedback>();bool canReview=(ViewBag.CanReview as bool?)??false;double average=feedback.Any()?feedback.Average(x=>x.Rating):0; }
<div class="page-heading"><div><div class="eyebrow">Workshop communication</div><h1>Announcements & Service Reviews</h1><p>Read workshop updates and ratings from completed customers.</p></div></div>
<div class="dashboard-grid"><div class="dashboard-stack">
@if(User.IsInRole("Admin")){<section class="panel"><div class="panel-header"><div><h2 class="panel-title">Publish Announcement</h2><div class="panel-subtitle">Visible to all signed-in members</div></div></div><form asp-action="Announcement" method="post"><div class="mb-3"><label class="form-label">Title</label><input name="title" class="form-control" required /></div><div class="mb-3"><label class="form-label">Message</label><textarea name="content" class="form-control" rows="4" required></textarea></div><button class="btn btn-primary">Publish Announcement</button></form></section>}
<section class="panel"><div class="panel-header"><div><h2 class="panel-title">Latest Announcements</h2><div class="panel-subtitle">Information from AutoCare Workshop</div></div></div>@if(!Model.Any()){<div class="empty-state"><p>No announcement is available.</p></div>}@foreach(var announcement in Model){<article class="form-section"><div class="d-flex justify-content-between gap-3"><strong>@announcement.Title</strong><small class="text-muted text-nowrap">@announcement.PublishedAt.ToString("dd MMM yyyy")</small></div><p class="text-muted mb-0 mt-2">@announcement.Content</p></article>}</section></div>
<div class="dashboard-stack">
@if(User.IsInRole("User")){<section class="panel"><div class="panel-header"><div><h2 class="panel-title">Service Review & Rating</h2><div class="panel-subtitle">Available after a completed workshop service</div></div></div>@if(!canReview){<div class="auth-note">Complete a workshop service before submitting a verified customer review.</div>}else{<form asp-action="Feedback" method="post"><label class="form-label">Your rating</label><div class="rating-picker mb-3">@for(int star=5;star>=1;star--){<input type="radio" name="rating" id="star@star" value="@star" required /><label for="star@star" title="@star star">★</label>}</div><div class="mb-3"><label class="form-label">Review</label><textarea name="comment" class="form-control" rows="4" maxlength="800" placeholder="Share your service experience..." required></textarea></div><button class="btn btn-primary">Submit Review</button></form>}</section>}
<section class="panel"><div class="panel-header"><div><h2 class="panel-title">Customer Reviews</h2><div class="panel-subtitle">@feedback.Count() review(s) · Average @average.ToString("0.0")/5</div></div><span class="status-badge">★ @average.ToString("0.0")</span></div>@if(!feedback.Any()){<div class="empty-state"><p>No review has been submitted.</p></div>}@foreach(var item in feedback){<article class="form-section"><div class="d-flex justify-content-between"><strong>@item.User?.FullName</strong><span class="review-stars">@string.Concat(Enumerable.Repeat("★",item.Rating))@string.Concat(Enumerable.Repeat("☆",5-item.Rating))</span></div><small class="text-muted">@item.SubmittedAt.ToString("dd MMM yyyy")</small><p class="text-muted mt-2">@item.Comment</p>@if(!string.IsNullOrWhiteSpace(item.AdminResponse)){<div class="auth-note"><strong>AutoCare response:</strong> @item.AdminResponse</div>}@if(User.IsInRole("Admin")){<form asp-action="Respond" method="post" class="d-flex gap-2 mt-2"><input type="hidden" name="id" value="@item.Id" /><input name="response" class="form-control" maxlength="800" placeholder="Write an Admin response" required /><button class="btn btn-primary">Reply</button></form>}</article>}</section></div></div>
