@model bool
@{ ViewData["Title"] = "Payment Result"; var invoice = ViewBag.Invoice as Invoice; }
<div class="panel mx-auto text-center" style="max-width:680px;padding:46px">@if(Model && invoice != null){<div class="metric-icon green mx-auto mb-3">✓</div><div class="eyebrow">Payment confirmed</div><h1 class="fw-bold">Thank you</h1><p class="text-muted">Stripe confirmed the test payment and AutoCare saved the payment record.</p><div class="display-5 fw-bold my-4">RM @invoice.Amount.ToString("N2")</div><div class="auth-note mb-4">Invoice #@invoice.Id<br />Reference: @invoice.PaymentReference<br />An e-receipt is sent when SMTP email is configured.</div><a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Return to Dashboard</a>}else{<div class="metric-icon red mx-auto mb-3">!</div><h1 class="h2 fw-bold">Payment not confirmed</h1><p class="text-muted">@ViewBag.Message</p><a class="btn btn-primary" asp-controller="Dashboard" asp-action="Index">Return to Dashboard</a>}</div>
