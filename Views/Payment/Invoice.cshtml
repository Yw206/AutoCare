@model Invoice
@{
    ViewData["Title"] = UiText.T(Context, "Printable Invoice", "可打印发票", "Invois Boleh Cetak");
    var appointment = Model.RepairJob?.Quotation?.Inspection?.Appointment;
}
<section class="panel invoice-print mx-auto" style="max-width:820px">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><div class="eyebrow">@UiText.T(Context, "AutoCare receipt", "AutoCare 收据", "Resit AutoCare")</div><h1>@UiText.T(Context, "Invoice", "发票", "Invois") #@Model.Id</h1><p class="text-muted mb-0">@UiText.T(Context, "Generated", "生成于", "Dijana") @DateTime.Now.ToString("dd MMM yyyy HH:mm")</p></div><img src="@ViewBag.QrCode" alt="Invoice QR reference" class="qr-code" /></div>
    <div class="row g-3 mb-4"><div class="col-md-6"><strong>@UiText.T(Context, "Customer", "客户", "Pelanggan")</strong><p class="text-muted mb-0">@appointment?.User?.FullName<br />@appointment?.User?.Email</p></div><div class="col-md-6"><strong>@UiText.T(Context, "Vehicle and service", "车辆与服务", "Kenderaan dan servis")</strong><p class="text-muted mb-0">@appointment?.Vehicle?.RegistrationNumber<br />@appointment?.WorkshopService?.Name</p></div></div>
    <table class="table data-table"><tbody><tr><th>@UiText.T(Context, "Amount", "金额", "Jumlah")</th><td class="text-end">RM @Model.Amount.ToString("N2")</td></tr><tr><th>@UiText.T(Context, "Status", "状态", "Status")</th><td class="text-end">@Model.PaymentStatus</td></tr><tr><th>@UiText.T(Context, "Method", "方式", "Kaedah")</th><td class="text-end">@(Model.PaymentMethod ?? UiText.T(Context, "Not recorded", "未记录", "Tidak direkodkan"))</td></tr><tr><th>@UiText.T(Context, "Reference", "参考编号", "Rujukan")</th><td class="text-end">@(Model.PaymentReference ?? UiText.T(Context, "Not recorded", "未记录", "Tidak direkodkan"))</td></tr><tr><th>@UiText.T(Context, "Paid At", "付款时间", "Dibayar Pada")</th><td class="text-end">@(Model.PaidAt?.ToString("dd MMM yyyy HH:mm") ?? UiText.T(Context, "Not paid", "未付款", "Belum dibayar"))</td></tr></tbody></table>
    <div class="quick-actions no-print"><button class="btn btn-primary" onclick="window.print()">@UiText.T(Context, "Print / Save PDF", "打印 / 保存 PDF", "Cetak / Simpan PDF")</button><a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">@UiText.T(Context, "Back", "返回", "Kembali")</a></div>
</section>
