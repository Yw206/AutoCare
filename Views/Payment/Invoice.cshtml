@model Invoice
@{ ViewData["Title"] = "Printable Invoice"; var appointment = Model.RepairJob?.Quotation?.Inspection?.Appointment; }
<section class="panel invoice-print mx-auto" style="max-width:820px">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4"><div><div class="eyebrow">AutoCare receipt</div><h1>Invoice #@Model.Id</h1><p class="text-muted mb-0">Generated @DateTime.Now.ToString("dd MMM yyyy HH:mm")</p></div><img src="@ViewBag.QrCode" alt="Invoice QR reference" class="qr-code" /></div>
    <div class="row g-3 mb-4"><div class="col-md-6"><strong>Customer</strong><p class="text-muted mb-0">@appointment?.User?.FullName<br />@appointment?.User?.Email</p></div><div class="col-md-6"><strong>Vehicle and service</strong><p class="text-muted mb-0">@appointment?.Vehicle?.RegistrationNumber<br />@appointment?.WorkshopService?.Name</p></div></div>
    <table class="table data-table"><tbody><tr><th>Amount</th><td class="text-end">RM @Model.Amount.ToString("N2")</td></tr><tr><th>Status</th><td class="text-end">@Model.PaymentStatus</td></tr><tr><th>Method</th><td class="text-end">@(Model.PaymentMethod ?? "Not recorded")</td></tr><tr><th>Reference</th><td class="text-end">@(Model.PaymentReference ?? "Not recorded")</td></tr><tr><th>Paid At</th><td class="text-end">@(Model.PaidAt?.ToString("dd MMM yyyy HH:mm") ?? "Not paid")</td></tr></tbody></table>
    <div class="quick-actions no-print"><button class="btn btn-primary" onclick="window.print()">Print / Save PDF</button><a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">Back</a></div>
</section>
