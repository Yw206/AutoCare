@model PurchaseHistoryVm
@{ ViewData["Title"]="Purchase Report"; }
<div class="page-heading"><div><div class="eyebrow">Member reporting</div><h1>Purchase History Report</h1><p>Review successful payments and monthly service spending.</p></div></div>
<div class="metric-grid report-metrics"><div class="metric-card"><div class="metric-icon green">RM</div><div><strong>RM @Model.Purchases.Sum(x=>x.Amount).ToString("N2")</strong><small>Total service spending</small></div></div><div class="metric-card"><div class="metric-icon">▤</div><div><strong>@Model.Purchases.Count</strong><small>Paid services</small></div></div></div>
<section class="panel mb-4"><div class="panel-header"><div><h2 class="panel-title">Purchase Report Chart</h2><div class="panel-subtitle">Paid workshop services during the latest six months</div></div></div><div class="chart-wrap"><canvas id="purchaseChart" aria-label="Monthly purchase chart"></canvas></div></section>
<section class="panel"><div class="panel-header"><div><h2 class="panel-title">Payment History</h2><div class="panel-subtitle">Successful payment records</div></div></div>@if(!Model.Purchases.Any()){<div class="empty-state"><div class="empty-icon">RM</div><h3 class="h6">No purchase records</h3><p>Your successful payments will appear here.</p></div>}else{<div class="table-responsive"><table class="table data-table"><thead><tr><th>Invoice</th><th>Date</th><th>Vehicle</th><th>Service</th><th>Method</th><th class="text-end">Amount</th></tr></thead><tbody>@foreach(var row in Model.Purchases){<tr><td>#@row.InvoiceId</td><td>@row.PaidAt.ToString("dd MMM yyyy")</td><td><strong>@row.RegistrationNumber</strong></td><td>@row.ServiceName</td><td>@row.PaymentMethod</td><td class="text-end"><strong>RM @row.Amount.ToString("N2")</strong></td></tr>}</tbody></table></div>}</section>
@section Scripts{<script>drawAutoCareBarChart('purchaseChart',@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchaseChart.Select(x=>x.Label))),@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchaseChart.Select(x=>x.Value))),'#f15a0a');</script>}
