@model PurchaseHistoryVm
@{ ViewData["Title"] = UiText.T(Context, "Purchase Report", "消费报告", "Laporan Pembelian"); }
<div class="page-heading"><div><div class="eyebrow">@UiText.T(Context, "Member reporting", "会员报告", "Laporan ahli")</div><h1>@UiText.T(Context, "Purchase History Report", "消费记录报告", "Laporan Sejarah Pembelian")</h1><p>@UiText.T(Context, "Review successful payments and monthly service spending.", "查看成功付款和每月服务消费。", "Semak bayaran berjaya dan perbelanjaan servis bulanan.")</p></div></div>
<div class="metric-grid report-metrics"><div class="metric-card"><div class="metric-icon green">RM</div><div><strong>RM @Model.Purchases.Sum(x=>x.Amount).ToString("N2")</strong><small>@UiText.T(Context, "Total service spending", "服务总消费", "Jumlah perbelanjaan servis")</small></div></div><div class="metric-card"><div class="metric-icon">▤</div><div><strong>@Model.Purchases.Count</strong><small>@UiText.T(Context, "Paid services", "已付款服务", "Servis dibayar")</small></div></div></div>
<section class="panel mb-4"><div class="panel-header"><div><h2 class="panel-title">@UiText.T(Context, "Purchase Report Chart", "消费报告图表", "Carta Laporan Pembelian")</h2><div class="panel-subtitle">@UiText.T(Context, "Paid workshop services during the latest six months", "最近六个月已付款的维修服务", "Servis bengkel berbayar dalam enam bulan terkini")</div></div></div><div class="chart-wrap"><canvas id="purchaseChart" aria-label="Monthly purchase chart"></canvas></div></section>
<section class="panel"><div class="panel-header"><div><h2 class="panel-title">@UiText.T(Context, "Payment History", "付款记录", "Sejarah Bayaran")</h2><div class="panel-subtitle">@UiText.T(Context, "Successful payment records", "成功付款记录", "Rekod bayaran berjaya")</div></div></div>@if(!Model.Purchases.Any()){<div class="empty-state"><div class="empty-icon">RM</div><h3 class="h6">@UiText.T(Context, "No purchase records", "没有消费记录", "Tiada rekod pembelian")</h3><p>@UiText.T(Context, "Your successful payments will appear here.", "您的成功付款会显示在这里。", "Bayaran berjaya anda akan dipaparkan di sini.")</p></div>}else{<div class="table-responsive"><table class="table data-table"><thead><tr><th>@UiText.T(Context, "Invoice", "发票", "Invois")</th><th>@UiText.T(Context, "Date", "日期", "Tarikh")</th><th>@UiText.T(Context, "Vehicle", "车辆", "Kenderaan")</th><th>@UiText.T(Context, "Service", "服务", "Servis")</th><th>@UiText.T(Context, "Method", "方式", "Kaedah")</th><th class="text-end">@UiText.T(Context, "Amount", "金额", "Jumlah")</th></tr></thead><tbody>@foreach(var row in Model.Purchases){<tr><td><a asp-controller="Payment" asp-action="Invoice" asp-route-id="@row.InvoiceId">#@row.InvoiceId</a></td><td>@row.PaidAt.ToString("dd MMM yyyy")</td><td><strong>@row.RegistrationNumber</strong></td><td>@row.ServiceName</td><td>@row.PaymentMethod</td><td class="text-end"><strong>RM @row.Amount.ToString("N2")</strong></td></tr>}</tbody></table></div>}</section>
@section Scripts{<script>drawAutoCareBarChart('purchaseChart',@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchaseChart.Select(x=>x.Label))),@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.PurchaseChart.Select(x=>x.Value))),'#f15a0a');</script>}
